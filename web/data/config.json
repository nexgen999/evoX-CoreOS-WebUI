  "about": {
    "title": "À propos",
    "text": "evoX Core OS est une interface statique configurable destinée à transformer un dépôt GitHub en portail web dynamique.",
    "background": "./web/assets/about-bg.svg",
    "cards": [
      {
        "title": "100% statique",
        "text": "Compatible GitHub Pages sans backend.",
        "icon": "check"
      },
      {
        "title": "Config-first",
        "text": "Les sources, textes, menus, visuels, services et badges sont centralisés dans un seul fichier.",
        "icon": "code"
      },
      {
        "title": "Auto-détection",
        "text": "Le dépôt, la branche et l’utilisateur GitHub sont détectés depuis l’URL de la page.",
        "icon": "github"
      }
    ]
