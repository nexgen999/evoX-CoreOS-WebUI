{
  // ==============================================================
  // evoX Core OS — CONFIGURATION
  // Copiez/comparez avec config.json. JSONC est le fichier explicatif.
  // ==============================================================
  "github": {
    // Dépôt de données CoreOS. Peut être différent du dépôt WebUI.
    "mode": "auto",
    "repository": "nexgen999/evoX-CoreOS",
    "dataRepository": "nexgen999/evoX-CoreOS",
    "webuiRepository": "nexgen999/evoX-CoreOS-WebUI",
    "branch": "main",
    // Laissez avatar/repository/user vides si vous voulez privilégier la détection.
    "user": "nexgen999",
    "avatar": "",
    "bio": "",
    "repos": ""
  },

  // ------------------------- SITE -------------------------------
  "site": {
    "name": "evoX Core OS",
    "title": "evoX Core OS · WebUI",
    "language": "fr",
    "year": "2026"
  },

  // ------------------------- HEADER -----------------------------
  // Les actions sont des boutons. iconUrl permet une icône PNG/SVG/ICO externe.
  "header": {
    "logo": "./web/assets/logo.svg",
    "subtitle": "WEBUI",
    "actions": []
  },

  // ------------------------- SIDEBAR ----------------------------
  // L'ordre ci-dessous est l'ordre visuel. enabled:false masque une entrée.
  "sidebar": {
    "menus": [],
    "card": {
      "title": "evoX Core OS",
      "text": "One place. All your needs."
    }
  },

  // ------------------------- RESEAUX SOCIAUX --------------------
  // Ajoutez autant de réseaux que nécessaire.
  "socials": [
    {
      "label": "GitHub",
      "url": "https://github.com/votre-compte",
      "icon": "github",
      "iconUrl": ""
    }
  ],

  // ------------------------- HOME -------------------------------
  // La Home possède ses propres sources RSS/OPML via sources.home.
  "home": {
    "hero": {
      "eyebrow": "evoX CORE OS",
      "title": "Bienvenue sur evoX Core OS",
      "text": "Votre texte.",
      "chips": []
    },
    "welcomeTitle": "Bienvenue !",
    "welcomeText": "Votre texte.",
    "thanksTitle": "Un immense merci !",
    "thanksText": "Votre texte.",
    "slogan": "Keep the spirit alive !",
    "newsLimit": 4,
    "quickResources": []
  },

  // ------------------------- SOURCES ----------------------------
  // Chaque section est indépendante.
  // home : flux propres à la Home.
  // news : lecteur RSS/Atom/OPML complet.
  // store : JSON du catalogue web.
  "sources": {
    "home": [
      {
        "type": "opml",
        "name": "CoreOS OPML",
        "url": "https://nexgen999.github.io/evoX-CoreOS/rss/source_aio.opml"
      }
    ],
    "news": [
      {
        "type": "rss",
        "name": "Payloads",
        "url": "https://nexgen999.github.io/evoX-CoreOS/rss/payloads_rss.xml"
      }
    ],
    "store": [
      {
        "name": "Payloads",
        "url": "https://nexgen999.github.io/evoX-CoreOS/json/payloads.json"
      }
    ]
  },

  // ------------------------- DOWNLOAD ---------------------------
  // Les URLs AIO CoreOS utilisent le tag release "latest".
  "download": {
    "aio": [],
    // Ajoutez ici n'importe quel fichier/logiciel supplémentaire.
    "other": [],
    // Les boutons Copier servent à Pegasus-DLCatalogue.
    "catalogues": []
  },

  // ------------------------- SERVICES ---------------------------
  // Ajoutez/supprimez librement des onglets.
  // type=external : URL fixe.
  // type=ps5 : URL construite avec IP + port + path.
  "services": {
    "defaultIp": "192.168.1.50",
    "tabs": [
      {
        "id": "webui",
        "label": "WebUI",
        "icon": "web",
        "type": "ps5",
        "items": [
          {
            "label": "WebUI principale",
            "description": "Interface locale.",
            "port": 12800,
            "path": ""
          }
        ]
      }
    ]
  },

  // ------------------------- DOCUMENTATION ---------------------
  // Tous les .md sous path sont détectés récursivement.
  // order permet de forcer le début de la navigation.
  "documentation": {
    "path": "docs",
    "order": []
  },

  // ------------------------- ABOUT / THANKS --------------------
  "about": { "text": "Votre texte.", "cards": [] },
  "thanks": { "text": "Votre texte.", "cards": [] },

  // ------------------------- FOOTER ----------------------------
  // Badges : label + URL. Ajoutez-en autant que nécessaire.
  "footer": {
    "text": "evoX Core OS",
    "badges": []
  }
}
