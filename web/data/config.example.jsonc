{
  // CONFIGURATION MAÎTRE evoX Core OS.
  // config.json est le fichier lu par le site. Ce JSONC explique toutes les options.
  // L'ordre du tableau navigation = ordre de la sidebar.
  "site": {"name":"evoX Core OS","shortName":"evoX","tagline":"One place. All your tools.","language":"fr","defaultPage":"home","theme":"dark","showThemeToggle":false},

  // Laisser owner/name/branch vides/auto pour détecter le dépôt depuis GitHub Pages.
  "autoDetect": {"enabled":true,"githubPages":true,"owner":true,"repository":true,"branch":"auto"},
  "repository": {"owner":"","name":"","branch":"auto","baseUrl":"","githubUrl":"","pagesUrl":"","apiBase":"https://api.github.com"},

  // Racines internes. Une source individuelle peut être une URL HTTPS.
  "paths": {"jsonDir":"/json/","rssDir":"/rss/","opmlDir":"/rss/","docsDir":"/docs/","assetsDir":"/web/assets/","archivesDir":"/archives/"},

  "navigation": [
    {"id":"home","label":"Home","icon":"home","enabled":true},
    {"id":"news","label":"News","icon":"rss","enabled":true},
    {"id":"downloads","label":"Download","icon":"download","enabled":true},
    {"id":"store","label":"Store","icon":"store","enabled":true},
    {"id":"services","label":"Services","icon":"link","enabled":true},
    {"id":"docs","label":"Documentation","icon":"book","enabled":true},
    {"id":"about","label":"About","icon":"info","enabled":true},
    {"id":"thanks","label":"Remerciements","icon":"heart","enabled":true}
  ],

  // News accepte RSS et Atom. OPML = liste d'outline avec xmlUrl.
  "news": {
    "enabled":true,"title":"News","eyebrow":"RSS / ATOM / OPML","description":"Lecteur de flux présenté comme un blog.",
    "background":"./web/assets/news-bg.svg","maxItems":100,
    "feeds":[{"id":"main","label":"Mon flux","url":"/rss/news.xml","enabled":true}],
    "opmlFiles":["/rss/sources.opml"],"autoDiscover":true,"autoDiscoverOpml":true
  },

  // IMPORTANT : les sources Home peuvent être différentes de celles de News.
  "homeNews": {"enabled":true,"maxItems":4,"feeds":[],"opmlFiles":["/rss/home.opml"],"autoDiscover":false,"autoDiscoverOpml":false},

  "downloads": {
    "enabled":true,"title":"Download","description":"Packs et fichiers prêts à télécharger.","search":true,
    "items":[{"name":"Pack AIO","filename":"pack.zip","category":"Packs","description":"Archive complète.","url":"/archives/pack.zip"}],
    "autoDiscover":false
  },

  // Store : découverte automatique des JSON de /json/ ou sources explicites.
  "store": {
    "enabled":true,"layout":"list","search":true,"showChecksum":true,"autoDiscover":true,
    "sources":[{"id":"payloads","label":"Payloads","url":"/json/payloads.json","arrayKeys":["payloads","items","data"]}],
    // Permet d'adapter le moteur à presque n'importe quelle structure JSON.
    "fieldMap":{"name":["name","title","filename"],"filename":["filename","file","name"],"url":["url","download","download_url","href"],"description":["description","desc","summary"],"version":["version","ver"],"author":["author","developer","creator"],"category":["category","type","group"],"subcategory":["subcategory","sub_category","subCategory"],"icon":["icon","image","logo"],"checksum":["checksum","sha256","sha-256"]},
    "subcategory":{"enabled":true,"inferFromPath":true,"pathSegments":1}
  },

  // Services publics + WebUI locales regroupées par catégories.
  "services": {
    "title":"Services","description":"Services publics et WebUI locales.","background":"./web/assets/services-bg.svg",
    "external":{"enabled":true,"title":"Services externes","items":[{"name":"GitHub","description":"Dépôts et code source.","icon":"github","url":"https://github.com/"}]},
    "local":{"enabled":true,"title":"WebUI locale / Console","description":"Saisissez l'IP de la console puis ouvrez une WebUI.","protocol":"http","defaultIp":"192.168.1.50","groups":[{"name":"WebUI PS5","icon":"store","items":[{"name":"WebUI principale","description":"Exemple.","icon":"globe","port":12800,"path":"/"}]}]}
  },

  // /docs/ est récursif. order accepte les chemins relatifs ; le reste est alphabétique.
  "docs":{"enabled":true,"root":"/docs/","recursive":true,"branch":"auto","order":["README.md","getting-started.md"],"hideFiles":[],"homeDocument":"README.md","rawFallback":true},

  // showLabel=false donne les boutons ronds. iconType=image + icon permet PNG/SVG/ICO personnalisés.
  "socials":[{"id":"github","label":"GitHub","url":"","icon":"github","showLabel":false,"enabled":true},{"id":"x","label":"X","url":"https://x.com/","icon":"x","showLabel":false,"enabled":true},{"id":"bluesky","label":"Bluesky","url":"https://bsky.app/","icon":"bluesky","showLabel":false,"enabled":true}],
  "topbar":{"showSocials":true,"quickDownloads":[{"label":"AIO Payloads (.zip)","url":"/archives/PS5_payloads_aio_latest.zip","icon":"download","showLabel":true,"enabled":true},{"label":"AIO PKG (.zip)","url":"/archives/PS5_pkg_aio_latest.zip","icon":"download","showLabel":true,"enabled":true}]},
  "sidebar":{"followMe":{"enabled":true,"title":"Suivez-moi"},"promo":{"enabled":true,"title":"evoX Core OS","text":"One place. All your needs.","background":"./web/assets/sidebar-bg.svg"}},

  "home": {
    "hero":{"eyebrow":"evoX CORE OS","title":"Bienvenue sur evoX Core OS","text":"Votre texte.","logo":"./web/assets/logo.svg","background":"./web/assets/hero-bg.svg","links":[]},
    "welcome":{"title":"👋 Bienvenue !","text":"Votre texte.","signature":"Votre nom","background":"./web/assets/welcome-bg.svg"},
    "storeSubtitle":"Accédez à tous mes outils et fichiers","quickDownloads":[],
    "thanks":{"title":"Un immense merci !","text":"Votre texte.","signature":"Keep the spirit alive ! ♡","background":"./web/assets/thanks-bg.svg"},"categoryTiles":[]
  },

  "about":{"title":"À propos","text":"Votre description.","background":"./web/assets/about-bg.svg","cards":[{"title":"Carte","text":"Votre texte.","icon":"check"}]},
  "thanks":{"title":"Un immense merci !","text":"Votre message.","background":"./web/assets/thanks-bg.svg","items":[{"name":"Communauté","text":"Merci !","icon":"heart"}]},

  // Footer : autant de liens et badges que nécessaire. Chaque badge peut être cliquable.
  "footer":{"enabled":true,"text":"evoX Core OS • Open Source • Configurable","showYear":true,"links":[{"label":"GitHub","url":"","newTab":true,"enabled":true}],"badges":[{"label":"License","href":"","image":"https://img.shields.io/github/license/OWNER/REPO?style=for-the-badge","alt":"License","enabled":true}]},
  "themeColors":{"accent":"#14c8ff","accent2":"#147cff","background":"#020a12","panel":"#061421","panel2":"#081a2b","text":"#eaf7ff","muted":"#82a5ba","line":"#0b4165","good":"#31dc91","danger":"#ff668c"},
  "advanced":{"cacheMinutes":10,"requestTimeoutMs":12000,"githubApiEnabled":true,"allowExternalJson":true,"allowExternalRss":true}
}
